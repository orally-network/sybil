type ApiKey = record {
    title : text;
    key : text;
};

type Source = variant {
    HttpSource : HttpSource;
    EvmEventLogsSource : EvmEventLogsSource;
};


type HttpSource = record {
    uri : text;
    api_keys : opt vec ApiKey;
    resolver : text;
    expected_bytes : opt nat64;
};

type EvmEventLogsSource = record {
    rpc : text;
    from_block : opt nat64;
    to_block : opt nat64;
    address : opt text;
    topic : opt text;
    block_hash : opt text;
    log_index : nat32;
    event_log_field_name : text;
    event_name : text;
    event_abi : text;
};

type FeedType = variant { Custom : null; CustomNumber : null; Customtext : null; Default : null };


type FeedStatus = record {
    last_update : nat64;
    updated_counter : nat64;
    requests_counter : nat64;
};

type Feed = record {
    id : text;
    feed_type : FeedType;
    update_freq : nat64;
    sources : opt vec HttpSource;
    new_sources : opt vec Source;
    decimals : opt nat64;
    status : FeedStatus;
    owner : text;
    data : opt AssetDataResult;
};

type CreateCustomFeedRequest = record {
    id : text;
    update_freq : nat;
    feed_type : FeedType;
    decimals : opt nat64;
    sources : vec Source;
    msg : text;
    sig : text;
};

type CreateDefaultFeedRequest = record {
    id : text;
    update_freq : nat;
    decimals : nat;
};

type ERC20Contract = record {
    erc20_contract : text;
    token_symbol : text;
    decimals : nat64;
};

type AllowedChain = record {
    rpc : text;
    erc20_contracts : vec ERC20Contract;
};

type BalancesCfg = record {
    rpc : text;
    chain_id : nat;
    erc20_contract : text;
    treasure_address : text;
    fee_per_byte : nat;
    base_fee : nat;
    allowed_chains : vec record {nat64 ; AllowedChain};
    whitelist : vec text;
};

type Cfg = record {
    exchange_rate_canister : principal;
    fallback_xrc : principal;
    evm_rpc_canister : principal;
    rpc_wrapper : text;
    mock : bool;
    key_name : text;
    balances_cfg : BalancesCfg;
};

type UpdateCfg = record {
    exchange_rate_canister : opt principal;
    fallback_xrc : opt principal;
    evm_rpc_canister : opt principal;
    rpc_wrapper : opt text; 
    mock : opt bool;
    key_name : opt text;
    balances_cfg : opt BalancesCfg;
};


type Pagination = record {
    page : nat64;
    size : nat64;
};
// Filter struct used to filter output of get_feeds method
type GetFeedsFilter = record {
    feed_type : opt FeedTypeFilter;
    owner : opt text;
    search : opt text;
};

type FeedTypeFilter = variant { Custom : null; Default : null };

// PaginationResult struct used as a response to request with pagination
type GetFeedsResultWithPagination = record {
    page: nat64;
    size: nat64;
    total_items: nat64;
    total_pages: nat64;
    items: vec Feed;
};


type AssetDataResult = record {
    data: AssetData;
    signature: opt text;
};

type MultipleAssetsDataResult = record {
    data: vec AssetData;
    signature: opt text;
};

type AssetData = variant {
    DefaultPriceFeed: record {
        symbol: text;
        rate: nat64;
        decimals: nat64;
        timestamp: nat64;
    };
    CustomPriceFeed: record {
        symbol: text;
        rate: nat64;
        decimals: nat64;
        timestamp: nat64;
    };
    CustomNumber: record {
        id: text;
        value: nat64;
        decimals: nat64;
    };
    Customtext: record {
        id: text;
        value: text;
    };
};

type ReadContractMetadata = record {
    chain_id: nat64;
    contract_address: text;
    method: text;
    params: text;
    timestamp: nat64;
};

type SolidityToken = variant {
    Address : text;
    FixedBytes : blob;
    Bytes : blob;
    Int : text;
    Uint : text;
    Bool : bool;
    text : text;
    FixedArray : vec SolidityToken;
    Array : vec SolidityToken;
    Tuple : vec SolidityToken;
};

type ReadContractResult = record {
    data: vec SolidityToken;
    meta: ReadContractMetadata;
    signature: opt text;
};

type ReadLogsMetadata = record {
    chain_id : nat64;
    block_from : opt nat64;
    block_to : opt nat64;
    topics0 : opt vec text;
    topics1 : opt vec text;
    topics2 : opt vec text;
    topics3 : opt vec text;
    addresses : opt vec text;
    timestamp : nat64;
};

type ReadLogsResult = record {
    data : vec ReadLogsData;
    meta : ReadLogsMetadata;
    signature : opt text;
};


type ReadLogsData = record {
    address : text;
    topics : vec text;
    data : blob;
    block_hash : opt text;
    block_number : opt nat64;
    transaction_hash : opt text;
    transaction_index : opt nat64;
    log_index : opt text;
    transaction_log_index : opt text;
    log_type : opt text;
    removed : opt bool;
};


type APIUser = record {
    address : text;
    request_count : nat64;
    request_count_per_method : vec record {text; nat64};
    request_count_per_domain : vec record {text; nat64};
    last_request : nat64;
    banned_domains : vec text;
    request_limit_by_domain : nat64;
    request_limit : nat64;
};

type SybilAPIKey = record {
    keys_to_user : vec record {text; APIUser};
    user_to_keys : vec record {text; vec text};
    free_request_limit : nat64;
};

type APIRequest = record {
    method : text; 
    count : nat;
    last_request : nat64;
};


type GetAssetDataWithProofResponse = variant { Ok : AssetDataResult; Err : text };
type GetAssetDataResponse = variant { Ok : AssetDataResult; Err: text };
type GetMultipleAssetsDataResponse = variant { Ok : MultipleAssetsDataResult; Err: text };
type GetFeedsResponse = variant { Ok : GetFeedsResultWithPagination; Err: text };
type GetFeedResponse = variant { Ok : opt Feed; Err: text };
type TextResponse = variant { Ok : text; Err: text };
type NatResponse = variant { Ok : nat; Err: text };
type BoolResponse = variant { Ok : bool; Err: text };
type GetCfgResponse = variant { Ok : Cfg; Err: text };
type GetWhitelistResponse = variant { Ok : vec text; Err: text };
type ReadContractResponse = variant { Ok : ReadContractResult; Err: text };
type ReadLogsResponse = variant { Ok : ReadLogsResult; Err: text };
type GetChainsRPCResponse = variant { Ok : vec text; Err: text };
type GetAllChainsRPCResponse = variant { Ok : vec record {nat64; vec text}; Err: text };
type GetUserAPIKeysResponse = variant { Ok : opt vec text; Err: text };
type GetUserByKeyResponse = variant { Ok : opt APIUser; Err: text };
type GetAPIKeysResponse = variant { Ok : SybilAPIKey; Err: text };
type GetRequestsByDomainResponse = variant { Ok : vec record {text; APIRequest}; Err: text };
type Error = variant { Ok : null; Err : text };


service : {
    // custom feeds
    create_custom_feed : (req : CreateCustomFeedRequest) -> (Error);
    remove_custom_feed : (id : text, msg : text, sig : text) -> (Error);
    
    // default feeds
    create_default_feed : (req : CreateDefaultFeedRequest) -> (Error);
    remove_default_feed : (id : text) -> (Error);

    // assets 
    get_asset_data_with_proof : (id : text, msg : opt text, sig : opt text) -> (GetAssetDataWithProofResponse);
    get_asset_data : (id : text, msg : opt text, sig : opt text) -> (GetAssetDataResponse);
    get_xrc_data : (id : text, msg : opt text, sig : opt text) -> (GetAssetDataResponse);
    get_xrc_data_with_proof : (id : text, msg : opt text, sig : opt text) -> (GetAssetDataResponse);
    get_multiple_assets_data_with_proof : (ids : vec text, msg : opt text, sig : opt text) -> (GetMultipleAssetsDataResponse);
    get_multiple_assets_data : (ids : vec text, msg : opt text, sig : opt text) -> (GetMultipleAssetsDataResponse);
    read_contract : (chain_id : nat64, function_signature: text, contract_address : text, method : text, params : text, msg : opt text, sig : opt text) -> (ReadContractResponse);
    read_logs : (chain_id : nat64, block_from : opt nat64, block_to : opt nat64, topic0 : opt vec text, topic1 : opt vec text, topic2 : opt vec text, topic3 : opt vec text, addresses : opt vec text, msg : opt text, sig : opt text) -> (ReadLogsResponse);
    is_feed_exists : (id : text) -> (bool);
    get_feeds : (filter: opt GetFeedsFilter, pagination: opt Pagination, msg: opt text, sig: opt text) -> (GetFeedsResponse);
    get_feed : (id: text, msg: opt text, sig: opt text) -> (GetFeedResponse);

    // allowances
    grant : (grantee : text, msg : text, sig : text) -> (Error);
    restrict : (grantee : text, msg : text, sig : text) -> (Error);

    // api keys
    get_requests_by_domain : () -> (GetRequestsByDomainResponse);
    get_api_key : (msg : text, sig : text) -> (TextResponse);
    get_user_api_keys : (address : text) -> (GetUserAPIKeysResponse);
    get_user_by_key : (key : text) -> (GetUserByKeyResponse);
    revoke_keys : (address : text) -> (Error);
    revoke_key : (key : text) -> ();
    update_free_request_limit : (new_limit : nat64) -> (Error);
    update_request_limit : (key : text, new_limit : nat64, msg : text, sig : text) -> (Error);
    update_request_limit_by_domain : (key : text, new_limit : nat64, msg : text, sig : text) -> (Error);
    get_api_keys : () -> (GetAPIKeysResponse);
    ban_domain : (key : text, domain : text, msg : text, sig : text) -> (Error);
    allow_domain : (key : text, domain : text, msg : text, sig : text) -> (Error);
    change_public_status : (key : text, is_public : bool, msg : text, sig : text) -> (Error);
    
    // controllers
    sign_message : (msg : text) -> (TextResponse);
    update_cfg : (cfg : UpdateCfg) -> (Error);
    get_cfg : () -> (GetCfgResponse);
    clear_state : () -> (Error);

    // canister
    eth_address : () -> (TextResponse);

    // chains_rpc 
    add_chain_rpc : (chain_id : nat64, url : text, secret : opt text) -> (Error);
    remove_chain_rpcs : (chain_id : nat64) -> (Error);
    remove_chain_rpc_by_index : (chain_id : nat64, index : nat64) -> (Error);
    get_chain_rpc : (chain_id : nat64) -> (GetChainsRPCResponse);
    get_all_chains_rpc : () -> (GetAllChainsRPCResponse);

    // balances
    add_to_balances_whitelist : (addresses : vec text) -> (Error);
    deposit : (chain_id : nat64, tx_hash : text, grantee : opt text, msg : text, sig : text) -> (Error);
    get_balance : (address : text) -> (NatResponse);
    //withdraw : (amount : nat, to : text, msg : text, sig : text) -> (TextResponse);
    //withdraw_fees : (to : text) -> (TextResponse);
    add_allowed_chain : (chain_id : nat64, rpc : text, coin_symbol : text) -> (Error);
    remove_allowed_chain : (chain_id : nat64) -> (Error);
    add_allowed_erc20_tokens : (chain_id : nat64, tokens : vec ERC20Contract) -> (Error);
    remove_allowed_erc20_tokens : (chain_id : nat64, tokens : vec text) -> (Error);
    update_treasure_address : (address : text) -> (Error);

    // whitelist
    add_to_whitelist : (address : text) -> (Error);
    remove_from_whitelist : (address : text) -> (Error);
    is_whitelisted : (address : text) -> (BoolResponse);
    get_whitelist : () -> (GetWhitelistResponse);
}